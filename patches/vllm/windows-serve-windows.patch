diff --git a/vllm/v1/engine/utils.py b/vllm/v1/engine/utils.py
index 90ec47e..2f60ee7 100644
--- a/vllm/v1/engine/utils.py
+++ b/vllm/v1/engine/utils.py
@@ -5,0 +6 @@ import os
+import sys
@@ -1033 +1034 @@ def wait_for_engine_startup(
-    if proc_manager is not None:
+    if proc_manager is not None and sys.platform != "win32":
@@ -1036 +1037 @@ def wait_for_engine_startup(
-    if coord_process is not None:
+    if coord_process is not None and sys.platform != "win32":
@@ -1039 +1040,13 @@ def wait_for_engine_startup(
-        events = poller.poll(STARTUP_POLL_PERIOD_MS)
+        events = poller.poll(
+            100 if sys.platform == "win32" else STARTUP_POLL_PERIOD_MS
+        )
+        if sys.platform == "win32":
+            finished = proc_manager.finished_procs() if proc_manager else {}
+            if coord_process is not None and coord_process.exitcode is not None:
+                finished[coord_process.name] = coord_process.exitcode
+            if finished:
+                raise RuntimeError(
+                    "Engine core initialization failed. "
+                    "See root cause above. "
+                    f"Failed core proc(s): {finished}"
+                )

